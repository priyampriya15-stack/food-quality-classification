# Root Environment Configuration Template
# Duplicate this file as .env or set individual configurations in backend/.env and frontend/.env

# ----------------------------------------
# Backend Configuration
# ----------------------------------------
APP_NAME="Food Quality Classification API"
APP_VERSION="1.0.0"
DEBUG=True
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (SQLite default)
DATABASE_URL="sqlite:///./food_quality.db"

# Model & Storage Paths
MODELS_DIR="../ml/models"
UPLOAD_DIR="./uploads"
DEFAULT_MODEL="efficientnet_b0"

# ----------------------------------------
# Frontend Configuration
# ----------------------------------------
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
