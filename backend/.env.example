# Backend Environment Variables
APP_NAME="Food Quality Classification API"
APP_VERSION="1.0.0"
DEBUG=True
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# SQLite Database
DATABASE_URL="sqlite:///./food_quality.db"

# ML Model Paths and Settings
MODELS_DIR="../ml/models"
UPLOAD_DIR="./uploads"
DEFAULT_MODEL="best"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS="jpg,jpeg,png,webp"

# Authentication & JWT Security
JWT_SECRET_KEY="foodquality-ai-production-secure-jwt-secret-key-32bytes-min-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=30
