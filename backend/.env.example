# Backend Environment Configuration Template
# Duplicate this file as backend/.env for local overrides, or configure via Render Dashboard

APP_NAME="Food Quality Classification API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
HOST=127.0.0.1
PORT=8000

# CORS Configuration: Comma-separated list of allowed frontend origins (e.g. http://localhost:5173,https://your-frontend.vercel.app)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (SQLite default; or postgresql://... connection string)
DATABASE_URL="sqlite:///./food_quality.db"

# ML Model Paths and Settings
MODELS_DIR="../ml/models"
UPLOAD_DIR="./uploads"
DEFAULT_MODEL="best"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS="jpg,jpeg,png,webp"

# Authentication & JWT Security
# Generate secure 64-char hex key via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="replace-with-your-generated-cryptographic-secret-key-32-chars-min"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=30
